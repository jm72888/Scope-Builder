{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "includeFiles": "{plan-prompt.md,questions-prompt.md,example/sample-details.json,lib/**}"
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
